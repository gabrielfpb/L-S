# Root .env for docker-compose variables
DB_USER=myadmin
DB_PASSWORD=supersecretpassword
DB_NAME=longshortquant_prod_db
DB_PORT_HOST=5432 # Host port for DB
DB_PORT_CONTAINER=5432

REDIS_PORT_HOST=6379 # Host port for Redis
REDIS_PORT_CONTAINER=6379

BACKEND_PORT_HOST=8000 # Host port for Backend API
BACKEND_PORT_CONTAINER=8000

FRONTEND_PORT_HOST=3000 # Host port for Frontend UI
FRONTEND_PORT_CONTAINER=80

SECRET_KEY=a_very_secure_secret_key_for_docker_compose_0123456789abcdef
# REPORTS_STORAGE_DIR is set within backend Dockerfile/compose, not needed here unless to override globally.

# Celery related URLs are constructed within docker-compose using DB_USER, DB_PASSWORD etc.
# and service names like 'redis' and 'db'.
# Variables like CELERY_BROKER_URL and CELERY_RESULT_BACKEND for the services
# are directly defined in the docker-compose.yml `environment` section for backend/worker.
# They use service discovery names (e.g., redis:6379), not host-exposed ports.
# So, no need to define them here unless you want to change the path (e.g. redis DB number).
# Example if you wanted to change redis DB numbers:
# CELERY_BROKER_DB_NUMBER=1
# CELERY_RESULT_DB_NUMBER=2
# Then in docker-compose.yml:
# CELERY_BROKER_URL=redis://redis:${REDIS_PORT_CONTAINER:-6379}/${CELERY_BROKER_DB_NUMBER:-1}
# CELERY_RESULT_BACKEND=redis://redis:${REDIS_PORT_CONTAINER:-6379}/${CELERY_RESULT_DB_NUMBER:-2}
# But current compose file hardcodes these DB numbers (1 and 2).
# The redis URL for general app use (e.g. caching) is redis DB 0.
# APP_REDIS_DB_NUMBER=0
# REDIS_URL=redis://redis:${REDIS_PORT_CONTAINER:-6379}/${APP_REDIS_DB_NUMBER:-0}
# This is also hardcoded in compose file.
# This root .env is primarily for HOST ports and DB credentials if you want to override defaults.
# The default values in docker-compose.yml (e.g. DB_USER:-postgres) will be used if not set here.
