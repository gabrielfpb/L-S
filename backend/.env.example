# backend/.env.example
DATABASE_URL="postgresql://youruser:yourpassword@db:5432/longshortquantdb"
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"
SECRET_KEY="a_very_secret_key_please_change_this_for_production"
REPORTS_STORAGE_DIR="generated_reports" # Example, can be an absolute path too

# Add your Alpha Vantage API Key here if you have one.
# Get a free key from: https://www.alphavantage.co/support/#api-key
# If not provided, the application will fall back to yfinance for market data.
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY_PLEASE_REPLACE
